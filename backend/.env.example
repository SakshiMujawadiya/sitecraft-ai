# ==============================================================================
# Backend Server Configuration & Environment Variables
# ==============================================================================

# Server Network & Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Session Security (JWT)
# Generate high-entropy 256-bit secrets for production deployment
JWT_SECRET=your_jwt_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# AI Provider API Keys (Optional - System includes built-in semantic engine fallback)
OPENAI_API_KEY=your_openai_api_key_optional
GEMINI_API_KEY=your_gemini_api_key_optional

# Email & Bot Protection (Optional in Development)
RECAPTCHA_SECRET_KEY=your_google_recaptcha_v3_secret_optional
RESEND_API_KEY=your_resend_api_key_optional
SMTP_FROM=SiteCraft AI <notifications@example.com>

# Custom Domain Hosting Infrastructure
CNAME_TARGET=sites.sitecraft.io
SERVER_IP=76.76.21.21
